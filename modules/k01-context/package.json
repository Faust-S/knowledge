{
  "name": "@iwxa/k01-context",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./document-source": {
      "types": "./adapters/document-source.d.mts",
      "default": "./adapters/document-source.mjs"
    },
    "./local-file": {
      "types": "./adapters/local-file.d.mts",
      "default": "./adapters/local-file.mjs"
    },
    "./revisioned-source": {
      "types": "./adapters/revisioned-source.d.mts",
      "default": "./adapters/revisioned-source.mjs"
    },
    "./atlas-public-source": {
      "types": "./integrations/atlas-public-source.d.mts",
      "default": "./integrations/atlas-public-source.mjs"
    },
    "./atlas-project-source": {
      "types": "./integrations/atlas-project-source.d.mts",
      "default": "./integrations/atlas-project-source.mjs"
    },
    "./project-continuation": {
      "types": "./integrations/project-continuation.d.mts",
      "default": "./integrations/project-continuation.mjs"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
