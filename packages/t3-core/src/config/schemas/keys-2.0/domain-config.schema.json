{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwxa.dev/schemas/domain-config.schema.json",
  "title": "IWXA Universal Domain Config (config_schema_version 1.0.0)",
  "description": "Universal shape for any /_iwxa/domain.json. The kernel ships one build for all domains — this schema does not enumerate production domains, origins, or brands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_schema_version",
    "config_version",
    "status",
    "domain_id",
    "origin",
    "local_store_name",
    "workspace_profile",
    "brand",
    "runtime",
    "modules",
    "enabled_profiles",
    "enabled_capabilities",
    "handoff",
    "service_worker",
    "diagnostics",
    "security",
    "release"
  ],
  "properties": {
    "config_schema_version": { "const": "1.0.0" },
    "config_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "origin": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "local_store_name": { "const": "iwxa-local" },
    "workspace_profile": { "type": "string", "minLength": 1, "maxLength": 64 },
    "brand": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        { "type": "object" }
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kernel_release": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runtime_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "local_store_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "package_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "current_manifest_path": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["service_id", "base_path"],
        "properties": {
          "service_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "base_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/[A-Za-z0-9._\\-/]*$"
          }
        }
      }
    },
    "enabled_profiles": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "enabled_capabilities": {
      "type": "array",
      "maxItems": 3,
      "items": { "enum": ["T0", "T1", "T2"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "receive_path",
        "allowed_origins",
        "require_preview",
        "default_expiry_seconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "receive_path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "allowed_origins": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "require_preview": { "type": "boolean" },
        "default_expiry_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        }
      }
    },
    "service_worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "future_path", "future_scope"],
      "properties": {
        "mode": { "const": "disabled" },
        "future_path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "future_scope": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "allow_secrets": { "type": "boolean" },
        "publish_source_maps": { "type": "boolean" },
        "directory_listing": { "type": "boolean" },
        "robots_indexing": { "type": "boolean" },
        "direct_indexeddb_for_modules": { "type": "boolean" },
        "module_service_worker": { "type": "boolean" },
        "allowed_object_classes": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "deployment_mode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "preserve_paths": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "release_must_exclude": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "backup_before_upload": { "type": "boolean" }
      }
    }
  }
}
