{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwxa.dev/schemas/relation.schema.json",
  "title": "IWXA Relation",
  "description": "Directed link between two objects inside the same workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["relation_id", "workspace_id", "from_object_id", "to_object_id", "kind", "created_at", "created_by_service"],
  "properties": {
    "relation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "workspace_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "from_object_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "to_object_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by_service": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}
