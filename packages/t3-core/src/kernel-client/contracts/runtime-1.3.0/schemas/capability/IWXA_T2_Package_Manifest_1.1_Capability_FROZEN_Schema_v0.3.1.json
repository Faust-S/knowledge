{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iwxa://schemas/package-manifest/1.1-capability",
  "title": "IWXA Package Manifest 1.1 Capability",
  "description": "TECHNICALLY_FROZEN fail-closed capability-aware package carrier. Kernel 0.1.1/0.1.2 rejects format_version != 1.0 before semantic import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "encryption",
    "created_at",
    "workspaces",
    "workspace_states",
    "options",
    "counts",
    "files",
    "package_digest",
    "semantic_digest",
    "capability"
  ],
  "properties": {
    "format": {
      "const": "iwxa.package"
    },
    "format_version": {
      "const": "1.1"
    },
    "encryption": {
      "const": "none"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspace_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "updated_at"
        ],
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_history",
        "include_assets",
        "include_relations",
        "include_schemas"
      ],
      "properties": {
        "include_history": {
          "type": "boolean"
        },
        "include_assets": {
          "type": "boolean"
        },
        "include_relations": {
          "type": "boolean"
        },
        "include_schemas": {
          "type": "boolean"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces",
        "objects",
        "events",
        "relations",
        "assets",
        "schemas"
      ],
      "properties": {
        "workspaces": {
          "type": "integer",
          "minimum": 0
        },
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "relations": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        },
        "schemas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(manifest\\.json|(content|assets|schemas|technical)/[^\\\\\\s][^\\\\]*)$",
            "maxLength": 240
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "path": {
                "const": "technical/capability/instance.json"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "path": {
                "const": "technical/capability/grant.json"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "instance_path",
        "grant_path"
      ],
      "properties": {
        "mode": {
          "const": "required"
        },
        "instance_path": {
          "const": "technical/capability/instance.json"
        },
        "grant_path": {
          "const": "technical/capability/grant.json"
        }
      }
    }
  }
}
