{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwxa.dev/schemas/service-passport.schema.json",
  "title": "IWXA Service Passport (T0-T2)",
  "description": "Canonical passport of a static service module. Wire format is snake_case. Every field including permissions is required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_id",
    "service_version",
    "base_path",
    "supported_levels",
    "input_object_types",
    "output_object_types",
    "schemas",
    "permissions"
  ],
  "properties": {
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "anyOf": [
          {
            "pattern": "\\.\\."
          },
          {
            "pattern": "[/\\\\]"
          }
        ]
      }
    },
    "service_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "base_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9._\\-/]*$"
    },
    "supported_levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "T0",
          "T1",
          "T2"
        ]
      }
    },
    "input_object_types": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "output_object_types": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "schemas": {
      "type": "object"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "objects",
        "events",
        "packages"
      ],
      "properties": {
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list",
            "read",
            "create",
            "soft_delete",
            "restore",
            "purge"
          ],
          "properties": {
            "list": {
              "type": "boolean"
            },
            "read": {
              "type": "boolean"
            },
            "create": {
              "type": "boolean"
            },
            "soft_delete": {
              "type": "boolean"
            },
            "restore": {
              "type": "boolean"
            },
            "purge": {
              "type": "boolean"
            }
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write",
            "delete"
          ],
          "properties": {
            "read": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9._-]*)$",
                "maxLength": 128
              }
            },
            "write": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9._-]*)$",
                "maxLength": 128
              }
            },
            "delete": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9._-]*)$",
                "maxLength": 128
              }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_scope"
          ],
          "properties": {
            "read_scope": {
              "enum": [
                "service",
                "workspace"
              ]
            }
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "export",
            "import",
            "export_scope",
            "import_scope"
          ],
          "properties": {
            "export": {
              "type": "boolean"
            },
            "import": {
              "type": "boolean"
            },
            "export_scope": {
              "enum": [
                "readable_objects",
                "workspace"
              ]
            },
            "import_scope": {
              "enum": [
                "writable_objects",
                "workspace"
              ]
            }
          }
        },
        "operations": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "t1.commitObjectGraph"
          }
        }
      }
    }
  }
}
