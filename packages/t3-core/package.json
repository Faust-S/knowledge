{
  "name": "@iwxa/t3-core",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-current-core-tests.mjs",
    "test:core": "node scripts/run-current-core-tests.mjs",
    "audit:source": "node scripts/source-preflight.mjs --report",
    "check:source": "node scripts/source-preflight.mjs",
    "build": "npm run check:runtime && vite build && node scripts/materialize-static-routes.mjs",
    "typecheck": "npm run check:runtime && tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\"",
    "test:workspace": "vitest run",
    "test:all": "npm run test:core && npm run test:workspace",
    "qualify:current:nonwindows": "node scripts/run-current-nonwindows-qualification.mjs",
    "test:t25-m11": "vitest run tests/t25-m11-common-floor.test.ts",
    "check:factory2": "node --test tests/factory2-completeness.test.mjs",
    "verify:current": "node scripts/run-current-executable-verification.mjs",
    "cache:prepare:current": "node scripts/prepare-current-dependency-cache.mjs",
    "assert:live": "node scripts/current-live-head.mjs",
    "fetch:live": "node scripts/current-live-head.mjs fetch",
    "qualify:factory2:preseal": "node scripts/run-factory2-preseal-qualification.mjs",
    "package:factory2:zip": "node scripts/factory2-deterministic-zip.mjs",
    "assemble:factory2:staging": "node scripts/assemble-factory2-staging.mjs",
    "prepare:factory2:release-technical": "node scripts/factory2-release-technical-readiness.mjs",
    "run:factory2:local": "node scripts/run-factory2-local-pipeline.mjs",
    "finalize:factory2:release": "node scripts/finalize-factory2-release.mjs",
    "domain:factory2": "node scripts/factory2-domain-run-cli.mjs",
    "selftest:factory2:fresh-extract": "node scripts/factory2-fresh-extract-selftest.mjs",
    "materialize:k035:atomic-successor": "node scripts/materialize-k035-atomic-graph-successor.mjs",
    "test:product-browser": "node --test tests/factory2-product-kernel.browser.mjs",
    "test:studio-browser": "node --test tests/factory2-studio.browser.mjs",
    "test:first-run": "node --experimental-strip-types --test tests/first-run-workspace.test.mjs tests/first-run-epoch.test.mjs tests/static-workspace-bootstrap.test.mjs tests/t2-capability-control-plane-metadata.test.mjs tests/stage-domain-security.test.mjs tests/first-run-host-recovery.test.mjs",
    "check:runtime": "node scripts/check-active-runtime-contract.mjs",
    "test:product:core": "node scripts/run-t3-product-core-tests.mjs",
    "test:product:workspace": "vitest run --config vitest.t3-product.config.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.8.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "version": "0.3.0-dev.0",
  "engines": {
    "node": ">=22.16.0"
  }
}
